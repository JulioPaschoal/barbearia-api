{
    "name": "barbearia-api",
    "version": "1.0.0",
    "description": "API para barbearia",
    "main": "index.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "prepare": "husky",
        "lint-staged": {
            "*.ts": [
                "eslint --fix",
                "prettier --write"
            ],
            "*.{json,md}": [
                "prettier --write"
            ]
        }
    },
    "keywords": [],
    "author": "JULIO PASCHOAL",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "express": "^5.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.0"
    }
}
